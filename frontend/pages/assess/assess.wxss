.form {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

input,
.picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.checkbox {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin: 0 18rpx 12rpx 0;
  font-size: 26rpx;
}

.submit {
  margin-top: 10rpx;
}

.error {
  margin-top: 16rpx;
  color: #dc2626;
}

.result-head {
  font-size: 28rpx;
  font-weight: 700;
  margin: 10rpx 0 16rpx;
}

.tier-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 24rpx 0 12rpx;
  color: #2563eb;
}

.rec {
  margin-bottom: 16rpx;
}

.rec-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.badges {
  margin-bottom: 10rpx;
}

.reason {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}
