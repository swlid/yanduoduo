.head {
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.badges {
  margin: 16rpx 0;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  color: #1f2937;
}

.label {
  color: #6b7280;
}

.link {
  color: #2563eb;
}

.card {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.metrics {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.metric-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2563eb;
}

.combo-year {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.combo {
  padding: 20rpx 0;
  border-top: 1rpx dashed #e5e7eb;
}

.combo-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.combo-title {
  font-size: 30rpx;
  font-weight: 700;
}

.mini-btn {
  width: 110rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  border-radius: 26rpx;
  background: #eef2ff;
  color: #2563eb;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
}

.compare-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
  color: #374151;
}

.bar-btn {
  width: 200rpx;
}

.retry-btn {
  margin-top: 20rpx;
}
