.form {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.field {
  margin-bottom: 22rpx;
}

.grid {
  display: flex;
  gap: 16rpx;
}

.grid .field {
  flex: 1;
}

.label {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

input,
.picker {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.score-name {
  width: 120rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.score-input {
  flex: 1;
  height: 72rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 0 16rpx;
}

.submit {
  margin-top: 10rpx;
}

.result {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #059669;
}
