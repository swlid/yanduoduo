.filters {
  margin-bottom: 20rpx;
}

.filter-input {
  height: 72rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.picker {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  color: #1f2937;
}

.filter-actions {
  display: flex;
  gap: 16rpx;
}

.filter-actions button {
  flex: 1;
}

.result {
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
}

.item {
  margin-bottom: 20rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-title {
  font-size: 32rpx;
  font-weight: 700;
}

.mini-btn {
  width: 110rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  border-radius: 26rpx;
  background: #eef2ff;
  color: #2563eb;
}

.badges {
  margin: 16rpx 0 10rpx;
}

.metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.metric-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2563eb;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
}
